# ==========================================================
# Baibhab Resorts & Conventions - Apache config
# Site is a Next.js static export (out/) with CLEAN URLs and
# FLAT files: /events/weddings is served from events/weddings.html.
# Upload this file to public_html/.htaccess.
# ==========================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Force HTTPS (remove this block if SSL is terminated by a CDN/proxy)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- 2. Strip trailing slash: /events/weddings/ -> /events/weddings (301).
  #        Old indexed slash-URLs are redirected; root "/" is untouched.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- 3. Serve clean URLs internally from flat files:
  #        /events/weddings -> events/weddings.html
  #        Real files (images, .xml, .txt, .css, .js) pass through untouched.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# --- Custom error pages (generated by the export)
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# --- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# --- Browser caching: HTML always fresh, assets 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- UTF-8 by default
AddDefaultCharset utf-8
