# ==========================================================
# Baibhab Resorts & Conventions - Apache config
# Site is a Next.js static export (out/) with CLEAN URLs and
# FLAT files: /events/weddings -> events/weddings.html.
#
# This version is LEFTOVER-PROOF: if old folder-style files
# (<name>/index.html) still exist on the server from a previous
# upload, they can never trigger redirect loops - the new flat
# pages always win, and old folders are served internally.
#
# Upload to public_html/.htaccess.
# (Assumes site is at the domain root, which it is.)
# ==========================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Force HTTPS (remove this block if SSL is terminated by a CDN/proxy)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- 2. "/path/" -> "/path" (301) - but ONLY when safe, i.e. no leftover
  #        directory owns this path (that combination caused the loop).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- 3. NEW SITE: /path -> path.html (flat file wins over old folders)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # --- 4. "/path/" variant: serve the new flat page directly, no redirect
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ $1.html [L]

  # --- 5. LEGACY SAFETY NET: /path where only an old folder exists ->
  #        serve path/index.html INTERNALLY (this is what stops the
  #        mod_dir bounce-back that created the infinite redirect).
  #        Delete the old <name>/ folders on the server to retire this rule.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# --- Custom error pages (generated by the export)
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# --- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# --- Browser caching: HTML always fresh, assets 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- UTF-8 by default
AddDefaultCharset utf-8
