# Public site URL (used for SEO metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.djhms.in

# SMTP settings – required for the Contact and Careers forms to deliver email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where enquiries / applications are delivered, and the From address
MAIL_TO=info@djhms.in
MAIL_FROM="DJHMS Website <no-reply@djhms.in>"
