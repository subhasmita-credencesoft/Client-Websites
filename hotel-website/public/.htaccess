# Custom Apache rules for Next.js Static Export with trailingSlash: true
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# 1. Redirect requests without trailing slash to trailing slash (except for files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 2. Serve existing real files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Fallback to 404.html if the requested resource is not found
ErrorDocument 404 /404.html
