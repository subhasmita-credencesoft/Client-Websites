# =============================================================================
# Hotel K2 — Apache configuration for the Next.js static export (out/)
# Deploy this file at the web root alongside the exported files.
# =============================================================================

# Serve index.html for directory requests and stop Apache guessing extensions.
DirectoryIndex index.html
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- 1. Force HTTPS ---------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- 2. Force the canonical www host ---------------------------------------
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # --- 3. Legacy room URLs -> current room URLs ------------------------------
  # Slugs that existed before the room catalogue was synced with the live API.
  RewriteRule ^rooms/standard-room/?$       /rooms/double-bed-standard-room  [R=301,L]
  RewriteRule ^rooms/deluxe-room/?$         /rooms/double-bed-premium-room   [R=301,L]
  RewriteRule ^rooms/premium-room/?$        /rooms/double-bed-premium-room   [R=301,L]
  RewriteRule ^rooms/super-premium-room/?$  /rooms/double-bed-premium-room   [R=301,L]
  RewriteRule ^rooms/apartment/?$           /rooms/four-bed-suite-room       [R=301,L]

  # --- 4. Extensionless URLs -> matching .html (required by `next export`) ----
  # /rooms/double-bed-standard-room  ->  /rooms/double-bed-standard-room.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # --- 5. Canonicalise directories to a trailing slash -----------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
</IfModule>

# --- 6. Custom 404 (exported as 404.html) ------------------------------------
ErrorDocument 404 /404.html

# --- 7. Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- 8. Cache policy ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML and feeds change often — always revalidate.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  # Immutable, content-hashed build assets.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|png|jpe?g|webp|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# --- 9. Correct MIME types ---------------------------------------------------
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
