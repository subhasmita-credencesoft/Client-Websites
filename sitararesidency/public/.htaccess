# ==============================================================================
# Hostinger Apache / LiteSpeed Configuration for Hotel Sitara Residency
# Next.js Static Export Deployment (output: 'export', trailingSlash: true)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------------------------
    # 1. FORCE HTTPS (SSL Redirection)
    # --------------------------------------------------------------------------
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --------------------------------------------------------------------------
    # 2. CANONICAL HOSTNAME (Force non-www)
    # --------------------------------------------------------------------------
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # --------------------------------------------------------------------------
    # 2b. REDIRECT RETIRED / REMOVED ROUTES
    # --------------------------------------------------------------------------
    RewriteRule ^dining(/.*)?$ /bedrooms/ [R=301,L]
    RewriteRule ^blog/the-tide-table/?$ /blog/navi-mumbai-travel-guide/ [R=301,L]
    RewriteRule ^blog/the-long-way-home/?$ /blog/panvel-weekend-getaways/ [R=301,L]
    RewriteRule ^blog/what-is-in-the-kitchen/?$ /blog/corporate-stay-kalamboli-panvel/ [R=301,L]

    # --------------------------------------------------------------------------
    # 3. PASS REAL FILES THROUGH UNTOUCHED (js, css, images, fonts, txt, json)
    # --------------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # --------------------------------------------------------------------------
    # 4. NEXT.JS RSC PAYLOAD REWRITES (client-side prefetch flat-file requests)
    # These flat files are mirrored by scripts/fix-rsc-payloads.mjs at build time.
    # The rewrites below serve as a fallback in case the flat copies are missing.
    # --------------------------------------------------------------------------
    RewriteCond %{DOCUMENT_ROOT}/$1/__next.$2/__PAGE__.txt -f
    RewriteRule ^(.+?)/__next\.(.+?)\._PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]

    RewriteCond %{DOCUMENT_ROOT}/$1/__next.$2/$d$slug/__PAGE__.txt -f
    RewriteRule ^(.+?)/__next\.(.+?)\.\$d\$slug\._PAGE__\.txt$ $1/__next.$2/$d$slug/__PAGE__.txt [L]

    # --------------------------------------------------------------------------
    # 5. DIRECTORY INDEX ROUTING (trailingSlash: true → each route = a folder)
    # --------------------------------------------------------------------------
    DirectoryIndex index.html

    # If visiting a directory and index.html exists inside it
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]

    # Fallback: check via document root (handles paths without trailing slash)
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]

    # Single-segment clean URL → file.html (legacy support)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Multi-segment clean URL → path.html (legacy support)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

</IfModule>

# ------------------------------------------------------------------------------
# 6. CUSTOM ERROR PAGES & DIRECTORY SECURITY
# ------------------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# ------------------------------------------------------------------------------
# 7. SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ------------------------------------------------------------------------------
# 8. GZIP COMPRESSION
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 9. BROWSER CACHING
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/plain "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|woff2|woff|avif|webp|png|jpe?g)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 10. BLOCK ACCESS TO SENSITIVE FILES
# ------------------------------------------------------------------------------
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule "^/\.well-known/" - [L]
</IfModule>

<FilesMatch "(package\.json|package-lock\.json|tsconfig\.json|next\.config\.ts|\.env.*|\.git.*)$">
    Order allow,deny
    Deny from all
</FilesMatch>
